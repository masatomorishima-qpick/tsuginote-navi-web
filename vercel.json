{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "hnd1"
  ],
  "crons": [
    {
      "path": "/api/cron/trial-reminders",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/disclose-expired",
      "schedule": "30 17 * * *"
    },
    {
      "path": "/api/cron/cleanup-death-documents",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/purge-disclosed-owners",
      "schedule": "0 19 * * *"
    },
    {
      "path": "/api/cron/login-reminders",
      "schedule": "0 23 * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "docs/listing-rules": false,
      "docs/**": false,
      "dependabot/**": false
    }
  },
  "ignoreCommand": "bash -c '[ \"$VERCEL_GIT_COMMIT_REF\" = \"main\" ] && exit 1; PREV=\"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\"; git diff --quiet \"$PREV\" HEAD -- . \":(exclude)docs\" \":(exclude)*.md\" \":(exclude)supabase/queries\"'"
}
